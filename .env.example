# Copy this to .env and fill in your values. Never commit .env.

DISCORD_TOKEN=your_discord_bot_token_here
NOTION_TOKEN=your_notion_integration_token_here

# Notion database IDs (found in the database URL after the workspace slug)
# Active roster = the new combat-role V2 table.
NOTION_ROSTER_DB_ID=your_roster_v2_database_id_here
# Legacy roster — source for the one-off /migrate_roster_v2 (and a backup).
NOTION_ROSTER_LEGACY_DB_ID=your_legacy_roster_database_id_here
NOTION_EVENT_LOG_DB_ID=your_event_log_database_id_here
NOTION_DISCHARGE_LOG_DB_ID=your_discharge_log_database_id_here
# Optional: LOA log database. If unset, the LOA flow still works — it just
# won't write a Notion paper trail. Columns: Member (title), Reason (text),
# Duration (text), Return (text), Status (select), Timestamp (date),
# Decided By (text).
NOTION_LOA_LOG_DB_ID=your_loa_log_database_id_here
# Weekly training schedule store. One database with its default title column
# plus a text column named exactly "Data" (the bot keeps the whole week there
# as JSON). If unset, the schedule commands are disabled.
NOTION_SCHEDULE_DB_ID=your_schedule_database_id_here
# Advancement log — permanent record of promotions/milestones; also powers the
# weekly digest's promotion count. Columns: Member (title), Rank (text),
# Type (select: Promotion/Milestone), Detail (text), Timestamp (date).
NOTION_ADVANCEMENT_LOG_DB_ID=your_advancement_log_database_id_here
# Strikes — disciplinary tracking. Columns: Member (title), Reason (text),
# Issued By (text), Timestamp (date).
NOTION_STRIKES_DB_ID=your_strikes_database_id_here
