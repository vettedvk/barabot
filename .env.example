# Copy this to .env and fill in your values. Never commit .env.

DISCORD_TOKEN=your_discord_bot_token_here
NOTION_TOKEN=your_notion_integration_token_here

# Notion database IDs (found in the database URL after the workspace slug)
NOTION_ROSTER_DB_ID=your_roster_database_id_here
NOTION_EVENT_LOG_DB_ID=your_event_log_database_id_here
NOTION_DISCHARGE_LOG_DB_ID=your_discharge_log_database_id_here
